// MEMORIA — modelo de datos inicial (Etapa 1 / MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  clerkUserId   String   @unique
  displayName   String
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  photos          Photo[]
  comments        Comment[]
  contributions   Contribution[]
  favorites       Favorite[]

  @@map("users")
}

model City {
  id             String   @id @default(cuid())
  name           String
  province       String?
  country        String
  slug           String   @unique
  latitude       Float
  longitude      Float
  description    String?
  coverImageUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  places Place[]

  @@map("cities")
}

model Place {
  id          String   @id @default(cuid())
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  address     String?
  latitude    Float
  longitude   Float
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos    Photo[]
  favorites Favorite[]

  @@unique([cityId, slug])
  @@map("places")
}

enum PhotoStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum SourceType {
  PERSONAL
  FAMILY_ARCHIVE
  PUBLIC_ARCHIVE
  MUSEUM
  NEWSPAPER
  BOOK
  INTERNET
  OTHER
}

// Preparado para procesamiento futuro (restauración / privacidad con IA).
// No implementado todavía: processingType siempre NONE en esta etapa.
enum ProcessingType {
  NONE
  PEOPLE_HIDDEN
  PEOPLE_REMOVED_AI_RECONSTRUCTED
}

model Photo {
  id               String   @id @default(cuid())
  placeId          String
  place            Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id])

  // El original nunca se sobrescribe. processedImageUrl queda reservado
  // para futuras versiones restauradas/reconstruidas con IA.
  originalImageUrl  String
  processedImageUrl String?
  processingType    ProcessingType @default(NONE)

  imageUrl      String
  thumbnailUrl  String?
  title         String?
  description   String?

  yearFrom          Int?
  yearTo             Int?
  exactDate         DateTime?
  dateIsApproximate Boolean @default(true)

  latitude  Float?
  longitude Float?

  sourceType      SourceType @default(OTHER)
  sourceText      String?
  photographer    String?
  copyrightText   String?

  status PhotoStatus @default(PUBLISHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      Comment[]
  contributions Contribution[]

  @@map("photos")
}

model Comment {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

enum ContributionType {
  DATE
  LOCATION
  IDENTIFICATION
  HISTORICAL_FACT
  CORRECTION
  OTHER
}

enum ContributionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Contribution {
  id      String @id @default(cuid())
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  type    ContributionType
  content String

  proposedYearFrom Int?
  proposedYearTo   Int?
  proposedLatitude Float?
  proposedLongitude Float?

  status ContributionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contributions")
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, placeId])
  @@map("favorites")
}
