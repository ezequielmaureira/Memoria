# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/memoria?schema=public"

# Puerto del servidor backend
PORT=4000

# URL del frontend (para CORS)
FRONTEND_URL="http://localhost:5173"

# Clerk (autenticación) — obtener claves en https://dashboard.clerk.com
# Dejar vacío en desarrollo si todavía no se configuró Clerk: las rutas que
# requieren login devolverán 401 hasta que se complete esta configuración.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Almacenamiento de imágenes
# STORAGE_DRIVER=local  -> guarda archivos en backend/uploads (solo desarrollo)
# STORAGE_DRIVER=cloudinary -> requiere las variables CLOUDINARY_* (futuro)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
